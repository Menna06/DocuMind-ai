# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4.1

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=5

# Application Paths
DATA_DIR=data
UPLOAD_DIR=data/uploads
VECTORSTORE_DIR=vectorstore

# Logging
LOG_LEVEL=INFO
